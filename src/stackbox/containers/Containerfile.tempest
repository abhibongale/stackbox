FROM docker.io/library/ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv python3-dev \
    gcc libffi-dev libssl-dev git iputils-ping openssh-client && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/tempest/venv
ENV PATH="/opt/tempest/venv/bin:$PATH"

RUN pip install --no-cache-dir tempest python-openstackclient python-ironicclient

ARG TEMPEST_PLUGIN_SOURCE=ironic-tempest-plugin
RUN pip install --no-cache-dir ${TEMPEST_PLUGIN_SOURCE}

RUN mkdir -p /opt/tempest/workspace && \
    tempest init /opt/tempest/workspace

WORKDIR /opt/tempest/workspace
CMD ["tempest", "run", "--regex", "ironic_tempest_plugin.tests.scenario"]
